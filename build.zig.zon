.{
    .name = .grpc,
    .version = "0.1.0",
    .fingerprint = 0x2b44e58cb7e473b7, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.1",
    .dependencies = .{
        .http = .{
            .url = "git+https://github.com/baskingspot/http#5acc5c5bb7a5c3532f4c9ae8366ec5d864ea3a3c",
            .hash = "http-0.4.2-bxrZzbQkEQAfvRGduCm4STITr5jSYAWLxq26xGUfMigN",
        },
        // The typed message codec the etcd example uses. Lazy: grpc itself does
        // not depend on it, and a consumer never fetches it.
        .protobuf = .{
            .url = "https://baskingspot.dev/protobuf/v0.2.0.tar.gz",
            .hash = "protobuf-0.2.0-cwbb_QSGAQCzFdiCY1Z6KvamRgV8wUeS0w9AOCYmuS9Z",
            .lazy = true,
        },
        // gzip for the conformance client. Lazy: grpc itself carries messages
        // and does not compress them.
        .compress = .{
            .url = "https://baskingspot.dev/compress/v0.3.0.tar.gz",
            .hash = "compress-0.3.0-VxR1WvF9PAAMMpzVjvKM-vNyBTMnHdkDb7dZSukhPCLE",
            .lazy = true,
        },
        // PEM credentials for the conformance server, at http's TLS revision.
        // Lazy: neither public grpc module needs this direct dependency.
        .tls = .{
            .url = "https://baskingspot.dev/tls/v0.4.1.tar.gz",
            .hash = "tls-0.4.1-nf2MKAeKKAAXtjhIUTb-AUO-pR7fe324iJHaphwpKhaC",
            .lazy = true,
        },
        // The test runner and the bench engine. Lazy: only the root build uses
        // them, and build.zig returns early for a consumer.
        .testingx = .{
            .url = "https://baskingspot.dev/testingx/v0.4.0.tar.gz",
            .hash = "testingx-0.4.0-ib95-2JkAwDVM639ma-akYafT4bdewLfpFaAEnLBzQXG",
            .lazy = true,
        },
        .stdx = .{
            .url = "https://baskingspot.dev/stdx/v0.5.0.tar.gz",
            .hash = "stdx-0.5.0-CcWegogqEQAvbEzD5F1r02a42hPX7GV82njuREakeC3a",
        },
        // The evented Io for the integration race's evented arm, pinned to
        // the default branch head. Lazy: only the root build uses it.
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio#5357759537d43c902d04c57cfa1a8a9e2a574fe3",
            .hash = "zio-0.20.1-xHbVVEIyLwBDRNXDTm2cJE9-yMPIbVICCUcelHSMDgz6",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
