.{
    .name = .grpc,
    .version = "0.3.2",
    .fingerprint = 0x2b44e58cb7e473b7, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.1",
    .dependencies = .{
        .http = .{
            .url = "https://baskingspot.dev/http/v0.8.1.tar.gz",
            .hash = "http-0.8.1-bxrZzQ4BFwCikwDsqzAjSrH8wX79iqWmwmKVIOr60eIg",
        },
        // The typed message codec the etcd example uses. Lazy: grpc itself does
        // not depend on it, and a consumer never fetches it.
        .protobuf = .{
            .url = "https://baskingspot.dev/protobuf/v0.2.0.tar.gz",
            .hash = "protobuf-0.2.0-cwbb_QSGAQCzFdiCY1Z6KvamRgV8wUeS0w9AOCYmuS9Z",
            .lazy = true,
        },
        // The gRPC compression registry's codecs. A consumer of grpc gets
        // compression out of the box; the wire registry is closed and this
        // is the org's implementation of it.
        .compress = .{
            .url = "https://baskingspot.dev/compress/v0.4.0.tar.gz",
            .hash = "compress-0.4.0-VxR1WnphPACdWf7g-MHTuia3HdkBRgnfD60TsKhyZXSR",
        },
        // PEM credentials for the conformance server, at http's TLS revision.
        // Lazy: neither public grpc module needs this direct dependency.
        .tls = .{
            .url = "https://baskingspot.dev/tls/v0.4.5.tar.gz",
            .hash = "tls-0.4.5-nf2MKKCiQgAx99zm0DJ4B2euY021-XyCcKgKZQK6ws89",
            .lazy = true,
        },
        // The test runner and the bench engine. Lazy: only the root build uses
        // them, and build.zig returns early for a consumer.
        .testingx = .{
            .url = "https://baskingspot.dev/testingx/v0.6.0.tar.gz",
            .hash = "testingx-0.6.0-ib95-yaGAwC1_nvSTOk8ktbCgVfBtDAVTCjNKgXRxBeo",
            .lazy = true,
        },
        .stdx = .{
            .url = "https://baskingspot.dev/stdx/v0.6.0.tar.gz",
            .hash = "stdx-0.6.0-CcWegpsXEQBPvqhuSRRDiRjq08s5gXavvTuvoL-Bo3BE",
        },
        // The evented Io for the integration race's evented arm, pinned to
        // the default branch head. Lazy: only the root build uses it.
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio#5357759537d43c902d04c57cfa1a8a9e2a574fe3",
            .hash = "zio-0.20.1-xHbVVEIyLwBDRNXDTm2cJE9-yMPIbVICCUcelHSMDgz6",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
